{
  "name": "@cloudexmachina/cxm",
  "version": "0.1.3",
  "description": "Query your CloudExMachina cloud cost drivers and savings opportunities from your coding agent (Claude Code, Codex).",
  "type": "module",
  "bin": {
    "cxm": "bin/cxm.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "commands",
    "hooks",
    "scripts",
    ".claude-plugin",
    ".codex-plugin"
  ],
  "scripts": {
    "test": "CXM_TELEMETRY=0 node --test",
    "prepublishOnly": "node --test",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin .codex-plugin",
    "validate:plugin": "node scripts/validate-manifests.mjs && node scripts/sync-version.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxmlabs/cxm-plugin.git"
  },
  "bugs": "https://github.com/cxmlabs/cxm-plugin/issues",
  "homepage": "https://cloudexmachina.io",
  "author": "Cloud ex Machina",
  "keywords": [
    "finops",
    "cloud-cost",
    "aws",
    "terraform",
    "cost-optimization",
    "claude-code",
    "codex",
    "coding-agent",
    "plugin"
  ],
  "license": "FSL-1.1-ALv2",
  "publishConfig": {
    "access": "public"
  }
}
