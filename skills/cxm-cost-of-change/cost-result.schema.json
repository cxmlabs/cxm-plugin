{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cost-of-change result",
  "description": "The structured form of the result in output.md. It holds the same values as the markdown section. When status is no_billed_unit_change, each amount and each doubt effect is in billed units per run, not in $/mo. The validator alone checks that each cite names a key of citations.",
  "type": "object",
  "required": ["schema_version", "organization", "status", "headlines", "targets", "results", "citations", "doubts"],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "required": ["failed"],
        "properties": { "headlines": { "maxItems": 0 }, "targets": { "maxItems": 0 }, "results": { "maxItems": 0 }, "doubts": { "maxItems": 0 }, "citations": { "maxProperties": 0 } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "no_billed_unit_change" } } },
      "then": { "properties": { "headlines": { "maxItems": 0 }, "targets": { "maxItems": 0 } } }
    }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "organization": { "type": "string", "minLength": 1 },
    "status": { "enum": ["priced", "no_billed_unit_change", "failed"] },
    "headlines": {
      "description": "One entry for each payer and each currency. Empty when status is not priced.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["payer", "currency", "list", "grade", "bound"],
        "properties": {
          "payer": { "type": "string", "minLength": 1 },
          "currency": { "type": "string", "minLength": 1 },
          "list": { "$ref": "#/$defs/range" },
          "effective": { "$ref": "#/$defs/range" },
          "grade": { "$ref": "#/$defs/grade" },
          "bound": { "enum": ["none", "floor", "ceiling"] }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "runs_here", "grade", "amounts"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "runs_here": {
            "type": "object",
            "required": ["value", "grade", "basis"],
            "properties": {
              "value": { "enum": ["yes", "no", "unknown"] },
              "grade": { "$ref": "#/$defs/grade" },
              "basis": { "type": "string", "minLength": 1 }
            }
          },
          "grade": { "$ref": "#/$defs/grade" },
          "amounts": {
            "type": "object",
            "required": ["list", "effective"],
            "properties": {
              "list": { "oneOf": [{ "$ref": "#/$defs/range" }, { "const": "unmeasured" }] },
              "effective": { "oneOf": [{ "$ref": "#/$defs/range" }, { "const": "unmeasured" }] }
            }
          }
        }
      }
    },
    "results": {
      "description": "One entry for each result line. When status is no_billed_unit_change, the two entries are the count before and the count after the diff.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "item", "amount", "factors"],
        "if": { "properties": { "amount": { "type": "object" } } },
        "then": { "required": ["grade"] },
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "item": { "type": "string", "minLength": 1 },
          "amount": { "oneOf": [{ "$ref": "#/$defs/range" }, { "const": "unmeasured" }] },
          "grade": { "$ref": "#/$defs/grade" },
          "factors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["value", "unit"],
              "if": { "properties": { "value": { "type": "number" } } },
              "then": { "required": ["grade", "cite"] },
              "else": { "required": ["reason"] },
              "properties": {
                "value": { "oneOf": [{ "type": "number" }, { "const": "unmeasured" }] },
                "unit": { "type": "string", "minLength": 1 },
                "reason": { "description": "Required when value is unmeasured.", "type": "string", "minLength": 1 },
                "grade": { "$ref": "#/$defs/grade" },
                "cite": { "description": "A key of citations. Required when value is a number.", "type": "string" }
              }
            }
          }
        }
      }
    },
    "citations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit", "formula", "source", "grade"],
        "properties": {
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "formula": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "grade": { "$ref": "#/$defs/grade" }
        }
      }
    },
    "doubts": {
      "description": "Always present. Empty when the section prints \"No doubt: every factor is A or B.\"",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "effect_low", "effect_high", "resolve"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "effect_low": { "type": "number" },
          "effect_high": { "oneOf": [{ "type": "number" }, { "const": "unmeasured" }] },
          "resolve": { "type": "string", "minLength": 1 }
        }
      }
    },
    "failed": {
      "description": "Required when status is failed. Then headlines, targets, results and doubts are empty lists, and citations is an empty object.",
      "type": "object",
      "required": ["count", "unit_of_work"],
      "properties": {
        "count": { "type": "string", "minLength": 1 },
        "unit_of_work": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "grade": { "enum": ["A", "B", "C", "D"] },
    "range": {
      "description": "A point has low equal to high.",
      "type": "object",
      "required": ["low", "high", "unit"],
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
